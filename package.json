{
  "name": "agent-finops",
  "version": "0.4.0",
  "private": true,
  "description": "Private, local-only token and cost reporting for coding agents",
  "type": "module",
  "bin": {
    "agent-finops": "src/cli.mjs"
  },
  "scripts": {
